+
+/* ── today tape ──────────────────────────────────────────────────────────*/
+.today {
+  display: flex;
+  flex-direction: column;
+  gap: var(--s3);
+  padding: var(--s3) var(--s4);
+  border: 1px solid var(--rule);
+  border-radius: var(--r-lg);
+  background: var(--panel);
+}
+
+.today-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--s3);
+  flex-wrap: wrap;
+}
+
+.today-title {
+  color: var(--ink);
+  font: 600 var(--t-lead) / 1.2 var(--font-display);
+  letter-spacing: var(--track-tight);
+}
+
+.today-sub {
+  margin: 0;
+  color: var(--ink-faint);
+  font-size: var(--t-small);
+  line-height: 1.4;
+}
+
+.tape {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  gap: var(--s2);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.tape-cell {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 2px;
+  width: 100%;
+  min-width: 0;
+  padding: var(--s2) var(--s3);
+  color: var(--ink);
+  text-align: start;
+  background: transparent;
+  border: 1px solid var(--rule);
+  border-radius: var(--r-sm);
+  cursor: pointer;
+}
+
+.tape-cell:hover,
+.tape-cell.on {
+  border-color: var(--phosphor-dim);
+  background: var(--panel-hi);
+}
+
+.tape-cell:focus-visible {
+  outline: 2px solid var(--action-focus);
+  outline-offset: 1px;
+}
+
+.tape-sym {
+  color: var(--ink);
+  font: 600 var(--t-small) / 1.2 var(--font-mono);
+  letter-spacing: 0.04em;
+}
+
+.tape-name {
+  color: var(--ink-faint);
+  font-size: var(--t-tiny);
+  line-height: 1.3;
+}
+
+.tape-last {
+  margin-block-start: 4px;
+  color: var(--ink);
+  font: 500 var(--t-fig) / 1 var(--font-mono);
+}
+
+.tape-chg {
+  font: 500 var(--t-small) / 1.2 var(--font-mono);
+}
+
+.tape-miss {
+  margin-block-start: 4px;
+  color: var(--ink-faint);
+  font-size: var(--t-tiny);
+  letter-spacing: 0.04em;
+}
+
+.look-at {
+  margin: 0;
+  color: var(--ink);
+  font-size: var(--t-small);
+  line-height: 1.45;
+}
+
+@media (max-width: 900px) {
+  .tape {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 520px) {
+  .tape {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
