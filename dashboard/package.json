{
  "name": "edge-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Live trading instrument panel for the edge/ research stack",
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-node.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clerk/vue": "^2.4.21",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.2.5",
    "@fontsource-variable/martian-mono": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/lora": "^5.3.0",
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
