# Optional local API deployment profile. Copy to .env.cloudflare and fill locally.
# The Cloudflare Worker itself defaults to static assets with API proxying off.
EDGE_HOST=127.0.0.1
PORT=8787
EDGE_AUTH_MODE=clerk
EDGE_REQUIRE_AUTH=1
EDGE_PUBLIC_DEPLOYMENT=0
# Public previews default background data refresh off; opt in only deliberately.
EDGE_BACKGROUND_JOBS=0
EDGE_OWNER_USER_ID=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
EDGE_CORS_ORIGINS=
VITE_EDGE_AUTH_MODE=clerk
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=30000
