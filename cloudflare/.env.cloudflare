# TradeCentral — Cloudflare deployment environment.
# Copy the relevant values into .env or the Cloudflare Pages build environment.
# The Python API stays bound to loopback; Cloudflare Tunnel + Access handle
# exposure and authentication. Hostname: tradecentral.syriltj1.workers.dev

# --- Python API server (runs locally, reached via Cloudflare Tunnel) ---
EDGE_HOST=127.0.0.1
PORT=8787

# Auth posture: Access at the Cloudflare edge is the gate. The Python server
# stays loopback so it never serves unauthenticated traffic directly.
EDGE_AUTH_MODE=local
EDGE_REQUIRE_AUTH=0

# Cloudflare Access forwards the browser's Origin. Mutating endpoints (POST)
# and CORS preflight need the public hostname allowlisted.
EDGE_CORS_ORIGINS=https://tradecentral.syriltj1.workers.dev

# --- Vue SPA build-time variables (must be present at `npm run build`) ---
# Local auth mode: the SPA skips Clerk and treats the operator as signed in.
# Cloudflare Access is the real gate.
VITE_EDGE_AUTH_MODE=local
VITE_EDGE_ALLOWED_EMAILS=

# Leave empty when the API is same-origin (served by api_server.py through
# the tunnel). Set to the API tunnel hostname only when the SPA is deployed
# separately to Pages and the API lives on a different hostname.
VITE_API_BASE_URL=

VITE_API_TIMEOUT_MS=30000
