# Copy to .env and fill in. Never commit the real .env.
LSE_API_KEY=

# Fintel Public Data API (https://api.fintel.io/)
# Generate at https://fintel.io/u/dev → "Generate Key"
# Sent server-side only as header: X-API-KEY: <this value>
# In Swagger UI: Authorize → paste the same key (not a Bearer token).
FINTEL_API_KEY=
# Optional overrides:
# FINTEL_API_BASE=https://api.fintel.io
# FINTEL_TIMEOUT_S=20
# FINTEL_CA_BUNDLE=/path/to/cacert.pem   # if system CAs missing (macOS Python)
# FINTEL_SSL_INSECURE=1                  # dev-only: disable TLS verify (not recommended)

# --- auth (Clerk) ---
# Clerk unlocks the dashboard operator session. Local mode keeps backend
# verification optional because the API only binds to loopback.
EDGE_AUTH_MODE=clerk
VITE_EDGE_AUTH_MODE=clerk
EDGE_ALLOWED_EMAILS=
VITE_CLERK_PUBLISHABLE_KEY=

# Browser request deadline. Keep this above the longest synchronous provider
# call; long scans return a job immediately and are polled separately.
VITE_API_TIMEOUT_MS=30000

# --- authenticated server profile (required for any network deployment) ---
# Keep EDGE_HOST on loopback for local development. To bind 0.0.0.0 or another
# network address, the server refuses to start until auth and CORS are safe.
EDGE_HOST=127.0.0.1
EDGE_REQUIRE_AUTH=0

# Networkless Clerk JWT verification. Copy the PEM public key from Clerk's API
# keys page and represent embedded newlines as \n inside the env value.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# Exact browser origins, comma separated; wildcard is rejected off-loopback.
EDGE_CORS_ORIGINS=

# Optional defense in depth: Clerk user IDs allowed to call the API. When
# empty, any valid session from this Clerk application is accepted.
EDGE_ALLOWED_USER_IDS=

# Resource guards for the stdlib threaded server.
EDGE_MAX_CONCURRENT_REQUESTS=32
EDGE_SOCKET_TIMEOUT_S=30
EDGE_ACCESS_LOG=0
